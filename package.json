{
  "name": "lpg-eds-storefront",
  "private": true,
  "type": "module",
  "version": "1.3.0",
  "description": "LPG and Wellbox Edge Delivery Services storefront (lab, based on adobe/aem-boilerplate)",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"blocks/**/*.css\" \"styles/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "install:dropins": "node build.mjs && node postinstall.js",
    "postinstall": "npm run install:dropins",
    "postupdate": "npm run install:dropins"
  },
  "author": "SQLI lab",
  "license": "Apache License 2.0",
  "devDependencies": {
    "@babel/eslint-parser": "7.29.13",
    "@dropins/build-tools": "1.2.2",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@dropins/storefront-auth": "4.1.1",
    "@dropins/storefront-cart": "3.4.1",
    "@dropins/storefront-pdp": "3.4.0",
    "@dropins/storefront-product-discovery": "3.1.3",
    "@dropins/tools": "3.0.0"
  }
}
